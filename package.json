{
  "name": "oneiros",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint",
    "format": "oxfmt",
    "icons": "bun scripts/icons.ts",
    "format:check": "oxfmt --check",
    "check": "cspell --no-progress && bun scripts/check.ts",
    "verify": "bun run build && bun run lint && bun run format:check && bun run check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "astro": "7.4.4",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21",
    "@commitlint/config-conventional": "^21",
    "@types/bun": "^1.4.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "cspell": "^10.5.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "pagefind": "^1.6.0",
    "sharp": "0.35.5",
    "typescript": "^6"
  }
}
