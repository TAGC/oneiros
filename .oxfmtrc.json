{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": [
    "node_modules",
    "bun.lock",
    "dist",
    ".astro",
    ".claude/",
    "reference/",
    "CLAUDE.md",
    "*.md",
    "*.mdx",
    "*.html",
    "*.json",
    "*.yml",
    "*.yaml",
    "*.svg"
  ]
}
