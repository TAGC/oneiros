---
import { hasIcon } from '../lib/icons';
import PixelIcon from './PixelIcon.astro';

interface Props {
  name: string;
  /** lg fills its container (tiles, category heads); md sits beside a page title; sm is inline. */
  size?: 'lg' | 'md' | 'sm';
}

const { name, size = 'lg' } = Astro.props;
---

{
  hasIcon(name) && (
    <span class:list={['frame', size !== 'lg' && size]} data-pagefind-ignore>
      <PixelIcon name={name} />
    </span>
  )
}
