---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { DEFAULT_LOCALE, type Locale, useTranslations } from '../i18n/ui';
import { renderInline } from '../lib/markdown';
import { categoryUrl } from '../lib/site';
import { categoryLabel } from '../lib/wiki';

interface Props {
  title: string;
  area: string;
  figure?: string;
  caption?: string;
  rows: { label: string; value: string }[];
  locale?: Locale;
}

const { title, area, figure, caption, rows, locale = DEFAULT_LOCALE } = Astro.props;
const t = useTranslations(locale);
const figures = import.meta.glob<{ default: AstroComponentFactory }>('./figures/*.astro', {
  eager: true,
});
const Figure = figure ? figures[`./figures/${figure}.astro`]?.default : undefined;
if (figure && !Figure) throw new Error(`Infobox figure "${figure}" not found in src/components/figures/`);
---

<aside class="infobox" aria-label={t.infoboxLabel(title)}>
  <div class="t" data-pagefind-ignore>{title}</div>
  {
    Figure && (
      <figure>
        <Figure />
        {caption && <figcaption>{caption}</figcaption>}
      </figure>
    )
  }
  <table>
    <tr data-pagefind-ignore>
      <th scope="row">{t.area}</th>
      <td><a href={categoryUrl(area, locale)}>{categoryLabel(area, locale)}</a></td>
    </tr>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td set:html={renderInline(row.value, undefined, locale)} />
        </tr>
      ))
    }
  </table>
</aside>
