---
import type { Locale } from '../i18n/ui';
import type { Status } from '../lib/status';
import { url } from '../lib/site';
import { statusLabel } from '../lib/wiki';
import IconFrame from './IconFrame.astro';

interface Props {
  status: Status;
  locale: Locale;
}

const { status, locale } = Astro.props;
---

<a class="stage-badge" href={url('/status/', locale)}>
  <IconFrame name={status} size="sm" />
  <span>{statusLabel(status, locale)}</span>
</a>
