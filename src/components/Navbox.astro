---
import navboxes from '../data/navboxes.json';
import { DEFAULT_LOCALE, type Locale } from '../i18n/locale';
import { resolve } from '../lib/wiki';
import WikiLink from './WikiLink.astro';

interface Props {
  id: string;
  current?: string;
  locale?: Locale;
}

/** `titleZh` and `labelZh` are optional; zh pages fall back to the English text. */
interface NavboxData {
  title: string;
  titleZh?: string;
  groups: { label: string; labelZh?: string; links: string[] }[];
}

const { id, current, locale = DEFAULT_LOCALE } = Astro.props;
const box = (navboxes as Record<string, NavboxData>)[id];
if (!box) throw new Error(`Navbox "${id}" not found in src/data/navboxes.json`);
const zh = locale === 'zh';
const title = (zh && box.titleZh) || box.title;
const groups = box.groups.map((g) => ({
  label: (zh && g.labelZh) || g.label,
  links: g.links.map((name) => {
    const found = resolve(name, locale);
    return { ...found, name: zh && found.exists && found.locale === 'zh' ? found.title : name };
  }),
}));
---

<nav class="navbox" aria-label={title} data-pagefind-ignore>
  <div class="t">{title}</div>
  {
    groups.map((g) => (
      <div class="row">
        <b>{g.label}</b>
        <span>
          {g.links.map((l, i) => (
            <>
              {i > 0 && ' · '}
              {l.slug === current ? (
                <strong>{l.name}</strong>
              ) : (
                <WikiLink to={{ ...l, title: l.name }} locale={locale}>
                  {l.name}
                </WikiLink>
              )}
            </>
          ))}
        </span>
      </div>
    ))
  }
</nav>
