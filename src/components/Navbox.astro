---
import navboxes from '../data/navboxes.json';
import { wikiUrl } from '../lib/site';
import { resolve } from '../lib/wiki';

interface Props {
  id: string;
  current?: string;
}

interface NavboxData {
  title: string;
  groups: { label: string; links: string[] }[];
}

const { id, current } = Astro.props;
const box = (navboxes as Record<string, NavboxData>)[id];
if (!box) throw new Error(`Navbox "${id}" not found in src/data/navboxes.json`);
const groups = box.groups.map((g) => ({
  label: g.label,
  links: g.links.map((name) => ({ name, ...resolve(name) })),
}));
---

<nav class="navbox" aria-label={box.title} data-pagefind-ignore>
  <div class="t">{box.title}</div>
  {
    groups.map((g) => (
      <div class="row">
        <b>{g.label}</b>
        <span>
          {g.links.map((l, i) => (
            <>
              {i > 0 && ' · '}
              {l.slug === current ? (
                <strong>{l.name}</strong>
              ) : l.exists ? (
                <a href={wikiUrl(l.slug)} data-t={l.slug}>
                  {l.name}
                </a>
              ) : (
                <a class="new" href={wikiUrl(l.slug)} title={`${l.name} (page does not exist)`}>
                  {l.name}
                </a>
              )}
            </>
          ))}
        </span>
      </div>
    ))
  }
</nav>
