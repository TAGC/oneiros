---
import Wiki from '../layouts/Wiki.astro';
import { getPages } from '../lib/pages';
import { categoryUrl, wikiUrl } from '../lib/site';

const terms = (await getPages()).filter((p) => p.entry.data.kind === 'term');
const areas = [...new Set(terms.map((t) => t.entry.data.area))].sort();
const letters = new Map<string, typeof terms>();
for (const t of terms) {
  const letter = t.title.charAt(0).toUpperCase();
  letters.set(letter, [...(letters.get(letter) ?? []), t]);
}
---

<Wiki title="Glossary index" description="Every Glossary term in the wiki, A to Z.">
  <h1>Glossary index</h1>
  <p class="sub">Every Glossary term with a page, A to Z. {terms.length} terms so far.</p>
  <fieldset class="filter">
    <legend>Area</legend>
    <button type="button" data-area="" aria-pressed="true">All</button>
    {
      areas.map((a) => (
        <button type="button" data-area={a} aria-pressed="false">
          {a}
        </button>
      ))
    }
  </fieldset>
  <div class="az">
    {
      [...letters].map(([letter, list]) => (
        <section data-letter={letter}>
          <h2>{letter}</h2>
          <dl>
            {list.map((t) => (
              <div data-area={t.entry.data.area}>
                <dt>
                  <a href={wikiUrl(t.slug)} data-t={t.slug}>
                    {t.title}
                  </a>{' '}
                  <small>
                    (<a href={categoryUrl(t.entry.data.area)}>{t.entry.data.area}</a>)
                  </small>
                </dt>
                <dd>{t.entry.data.summary}</dd>
              </div>
            ))}
          </dl>
        </section>
      ))
    }
  </div>
</Wiki>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filter button')];
  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const area = btn.dataset.area ?? '';
      for (const b of buttons) b.setAttribute('aria-pressed', String(b === btn));
      for (const item of document.querySelectorAll<HTMLElement>('.az [data-area]')) {
        item.hidden = Boolean(area) && item.dataset.area !== area;
      }
      for (const section of document.querySelectorAll<HTMLElement>('.az section')) {
        section.hidden = !section.querySelector('[data-area]:not([hidden])');
      }
    });
  }
</script>
