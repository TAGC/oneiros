---
import IconFrame from '../components/IconFrame.astro';
import Wiki from '../layouts/Wiki.astro';
import { AREAS } from '../lib/areas';
import { renderMarkdown } from '../lib/markdown';
import { getCategories, getPages } from '../lib/pages';
import { categoryUrl, url } from '../lib/site';
import { TABS } from '../lib/sheet';

const pages = await getPages();
const categories = await getCategories();
const openCount = pages.reduce((n, p) => n + p.callouts.length, 0);

const welcome = renderMarkdown(`
Oneiros is a dream journal that becomes a game you can share. It is a systemic RPG in the spirit of Caves of Qud, set in [[Dreamlands|the Dreamlands]]: the dream of [[Dreamer|the Dreamer]], a vast, cosmic and unknowable being, shared by everyone who plays.

You write down your real dreams, and they become places in the world that you can explore, grow and share with other players. Around them is a full RPG of emotional magic, shifting rumours and a world that turns through sleep cycles.

Five pillars hold it together:

- **Dream world:** a living dream that keeps surfacing new regions
- **Emotion magic:** eight emotions, each a motion of the will; magic changes how things feel
- **Your dreams as Reveries:** the journal is the game's most distinctive feature, though optional
- **Grows itself:** an LLM fills gaps in the world, always within the engine's rules
- **Fair to play free:** paying buys novelty, never power
`);
---

<Wiki title="Oneiros Wiki" description="The Oneiros game design wiki: a systemic RPG set in the Dreamlands.">
  <h1>Welcome to the Oneiros Wiki</h1>
  <p class="sub">A just-for-fun game design project. {pages.length} pages so far.</p>
  <div class="lede" set:html={welcome} />

  <h2>Explore the Dreamlands</h2>
  <ul class="tiles">
    {
      AREAS.map((area) => {
        const n = categories.get(area)?.length ?? 0;
        return (
          <li>
            <a class="tile" href={categoryUrl(area)}>
              <IconFrame name={area} />
              <span class="lab">{area}</span>
              <span class="desc">{n === 1 ? '1 page' : `${n} pages`}</span>
            </a>
          </li>
        );
      })
    }
  </ul>

  <h2>Find your way</h2>
  <ul class="cards">
    <li>
      <b><a href={url('/glossary/')}>Glossary index</a></b>
      Every term of the domain language, A to Z, filterable by area.
    </li>
    <li>
      <b><a href={url('/tables/')}>Sheet tables</a></b>
      All {TABS.length} tabs of the reference sheet.
    </li>
    <li>
      <b><a href={url('/open-questions/')}>Open questions</a></b>
      {openCount} open questions and conflicts waiting to be settled.
    </li>
    <li>
      <b><a href={url('/random/')}>Random page</a></b>
      Drift somewhere new.
    </li>
  </ul>
</Wiki>
