---
import SheetTable from '../../../components/SheetTable.astro';
import { type Locale, LOCALES, localeParam, useTranslations } from '../../../i18n/ui';
import Wiki from '../../../layouts/Wiki.astro';
import { url } from '../../../lib/site';
import { isArchive, localTab, TABS, tabTitle } from '../../../lib/sheet';

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    TABS.map((tab) => ({
      params: { locale: localeParam(locale), tab: tab.slug },
      props: { slug: tab.slug, locale },
    })),
  );
}

interface Props {
  slug: string;
  locale: Locale;
}

const { slug, locale } = Astro.props;
const t = useTranslations(locale);
const { tab, translated } = localTab(slug, locale);
const title = tabTitle(tab);
---

<Wiki
  title={title}
  description={t.tabDescription(title)}
  locale={locale}
  path={`/tables/${tab.slug}/`}
>
  <h1>{title}</h1>
  <p class="sub">
    <a href={url('/tables/', locale)}>{t.sheetTables}</a>{isArchive(tab) && ` · ${t.archiveSub}`}
  </p>
  {
    !translated && (
      <p class="data-note">
        <span class="tag">{t.englishData}</span> {t.englishDataNote}
      </p>
    )
  }
  {tab.blocks.map((_, i) => <SheetTable tab={tab.slug} block={i} locale={locale} note={false} />)}
</Wiki>
