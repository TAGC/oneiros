---
import IconFrame from '../../components/IconFrame.astro';
import WikiLink from '../../components/WikiLink.astro';
import { type Locale, localePaths, useTranslations } from '../../i18n/ui';
import Wiki from '../../layouts/Wiki.astro';
import { getPages } from '../../lib/pages';
import { STATUSES } from '../../lib/status';
import { resolve, statusLabel } from '../../lib/wiki';

export const getStaticPaths = localePaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const stages = resolve('Belief stages', locale);
const pages = await getPages(locale);
const byStatus = STATUSES.map((s) => ({
  status: s,
  pages: pages
    .filter((p) => p.entry.data.status === s)
    .sort((a, b) => a.title.localeCompare(b.title, locale)),
}));
---

<Wiki title={t.status} description={t.statusDescription} locale={locale} path="/status/">
  <h1>{t.status}</h1>
  <p class="sub">{t.statusDescription}</p>
  <p>{t.statusIntro}</p>
  <p>{t.statusStagesLead}</p>
  <div class="wt-wrap">
    <table class="wt stages-table">
      <thead>
        <tr>
          <th scope="col" aria-label={t.statusIcon}></th>
          <th scope="col">{t.statusStage}</th>
          <th scope="col">{t.statusMeaning}</th>
        </tr>
      </thead>
      <tbody>
        {
          STATUSES.map((s) => (
            <tr>
              <td class="stage-icon">
                <IconFrame name={s} size="md" />
              </td>
              <td>
                <strong>{statusLabel(s, locale)}</strong>
              </td>
              <td>{t.statusMeanings[s]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p>
    {t.statusNote[0]}<WikiLink to={stages} locale={locale}>{t.statusBeliefStages}</WikiLink>{t.statusNote[1]}
  </p>
  <h2>{t.statusRulesHeading}</h2>
  <ul>
    {t.statusRules.map((rule) => <li>{rule}</li>)}
  </ul>
  <h2>{t.statusPagesHeading}</h2>
  {
    byStatus.map(({ status, pages }) => (
      <section class="status-group">
        <h3 class="cat-head">
          <IconFrame name={status} size="sm" />
          <span>{statusLabel(status, locale)}</span>
          <span class="count">{t.pageCount(pages.length)}</span>
        </h3>
        {pages.length ? (
          <ul class="page-list">
            {pages.map((p) => (
              <li>
                <WikiLink to={p} locale={locale}>
                  {p.title}
                </WikiLink>
                <span class="s" lang={p.locale === locale ? undefined : p.locale}>
                  {t.colon + p.entry.data.summary}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p>{t.statusNoPages}</p>
        )}
      </section>
    ))
  }
</Wiki>
