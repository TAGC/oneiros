---
import WikiLink from '../../components/WikiLink.astro';
import { type Locale, localePaths, useTranslations } from '../../i18n/ui';
import Wiki from '../../layouts/Wiki.astro';
import { renderMarkdown } from '../../lib/markdown';
import { AREAS } from '../../lib/areas';
import { getPages } from '../../lib/pages';
import { getQuestions, type Question } from '../../lib/questions';
import { url, wikiUrl } from '../../lib/site';
import { calloutHeading } from '../../lib/wiki';

export const getStaticPaths = localePaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const questions = getQuestions();
const pages = (await getPages(locale)).filter((p) => p.callouts.length);
const marked = new Set(pages.flatMap((p) => p.callouts.map((c) => c.issue)));
const unmarked = questions.all().filter((q) => q.state === 'open' && !marked.has(q.number));
const groups = [...AREAS, undefined]
  .map((area) => ({ area, list: unmarked.filter((q) => q.area === area) }))
  .filter((g) => g.list.length);
const count = pages.reduce((n, p) => n + p.callouts.length, 0) + unmarked.length;

function textOf(q: Question): { markdown: string; lang: Locale } {
  const lang = q.text[locale] === undefined ? 'en' : locale;
  return { markdown: q.text[lang] ?? '', lang };
}
---

<Wiki
  title={t.openQuestions}
  description={t.openDescription}
  locale={locale}
  path="/open-questions/"
>
  <h1>{t.openQuestions}</h1>
  <p class="sub">{t.openSub(count)}</p>
  <p><a href={url('/astrolabe/', locale)}>{t.astrolabe.seeMap}</a></p>
  {count === 0 && <p>{t.openNone}</p>}
  {
    pages.map((p) => (
      <section>
        <h2>
          <WikiLink to={p} locale={locale}>
            {p.title}
          </WikiLink>
        </h2>
        {p.callouts.map((c) => (
          <div class={`note note-${c.kind}`}>
            <p class="note-h">
              <strong>
                {calloutHeading(
                  c.kind,
                  locale,
                  c.issue === undefined ? undefined : questions.get(c.issue),
                )}
              </strong> ·{' '}
              <a href={wikiUrl(p.slug, c.id, p.locale)}>{t.onThePage}</a>
            </p>
            {p.locale === locale ? (
              <Fragment set:html={renderMarkdown(c.markdown, p.slug, p.locale)} />
            ) : (
              <div lang={p.locale} set:html={renderMarkdown(c.markdown, p.slug, p.locale)} />
            )}
          </div>
        ))}
      </section>
    ))
  }
  {
    groups.length > 0 && (
      <section>
        <h2>{t.openUnmarked}</h2>
        <p>{t.openUnmarkedSub}</p>
        {groups.map((g) => (
          <>
            <h3>{g.area ? (t.areaNames[g.area] ?? g.area) : t.noArea}</h3>
            {g.list.map((q) => {
              const { markdown, lang } = textOf(q);
              return (
                <div class={`note note-${q.kind}`}>
                  <p class="note-h">
                    <strong>{calloutHeading(q.kind, locale, q)}</strong> ·{' '}
                    <a href={q.url}>{t.onGithub(q.number)}</a>
                  </p>
                  <p>
                    <strong>{q.title[locale] ?? q.title.en}</strong>
                  </p>
                  {lang === locale ? (
                    <Fragment set:html={renderMarkdown(markdown, undefined, lang)} />
                  ) : (
                    <div lang={lang} set:html={renderMarkdown(markdown, undefined, lang)} />
                  )}
                </div>
              );
            })}
          </>
        ))}
      </section>
    )
  }
</Wiki>
