---
import QuestionBox from '../../components/QuestionBox.astro';
import WikiLink from '../../components/WikiLink.astro';
import { type Locale, localePaths, useTranslations } from '../../i18n/ui';
import Wiki from '../../layouts/Wiki.astro';
import { AREAS } from '../../lib/areas';
import { getPages, type Page } from '../../lib/pages';
import { getQuestions, type Question } from '../../lib/questions';
import { getConstellations, isFinished } from '../../lib/questions/constellations';
import { url, wikiUrl } from '../../lib/site';
import { calloutHeading, type MarkerBox } from '../../lib/wiki';

export const getStaticPaths = localePaths;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const questions = getQuestions();
const constellations = getConstellations(questions);
const pages = (await getPages(locale)).filter((p) => p.markers.length);
/** Where each question issue is marked: its page and its box there. */
const markedOn = new Map<number, { page: Page; marker: MarkerBox }>();
for (const page of pages) {
  for (const marker of page.markers) {
    markedOn.set(marker.issue, { page, marker });
  }
}
const unmarked = questions.all().filter((q) => q.state === 'open' && !markedOn.has(q.number));
const count = pages.reduce((n, p) => n + p.markers.length, 0) + unmarked.length;

const grouped = (issue: number) => {
  const c = constellations.of(issue);
  return c !== undefined && !isFinished(c);
};
const ungroupedPages = pages
  .map((p) => ({ ...p, markers: p.markers.filter((m) => !grouped(m.issue)) }))
  .filter((p) => p.markers.length);
const ungroupedUnmarked = unmarked.filter((q) => !grouped(q.number));
const areas = [...AREAS, undefined]
  .map((area) => ({ area, list: ungroupedUnmarked.filter((q) => q.area === area) }))
  .filter((g) => g.list.length);

/** A text in the viewer's language, or in English, with the language it is in. */
function inLocale(text: Partial<Record<Locale, string>>): { text: string; lang: Locale } {
  const lang = text[locale] === undefined ? 'en' : locale;
  return { text: text[lang] ?? '', lang };
}

/** A question issue's box: its text from the page that marks it, or from the issue. */
function issueBox(q: Question) {
  const marked = markedOn.get(q.number);
  const { text, lang } = inLocale(q.text);
  return {
    kind: q.kind,
    heading: calloutHeading(q.kind, locale, q),
    links: [
      marked
        ? {
            href: wikiUrl(marked.page.slug, marked.marker.id, marked.page.locale),
            text: marked.page.title,
          }
        : { text: t.openUnmarked },
      { href: q.url, text: t.onGithub(q.number) },
    ],
    title: q.title[locale] ?? q.title.en,
    markdown: marked ? marked.marker.markdown : text,
    page: marked?.page.slug ?? q.properties.page,
    lang: marked ? marked.page.locale : lang,
    locale,
  };
}
---

<Wiki
  title={t.openQuestions}
  description={t.openDescription}
  locale={locale}
  path="/open-questions/"
>
  <h1>{t.openQuestions}</h1>
  <p class="sub">{t.openSub(count)}</p>
  <p><a href={url('/astrolabe/', locale)}>{t.astrolabe.seeMap}</a></p>
  {count === 0 && <p>{t.openNone}</p>}
  {
    constellations.open().map((c) => {
      const name = inLocale(c.name);
      const reasoning = inLocale(c.reasoning);
      const open = c.questions.filter((q) => q.state === 'open');
      const facts = [
        c.size && t.constellationFact(t.constellationSize, t.constellationSizes[c.size]),
        c.energy && t.constellationFact(t.constellationEnergy, t.constellationEnergies[c.energy]),
        t.constellationSettled(c.questions.length - open.length, c.questions.length),
      ].filter(Boolean);
      return (
        <section>
          <h2 lang={name.lang === locale ? undefined : name.lang}>{name.text}</h2>
          <p class="sub">{facts.join(' · ')}</p>
          {reasoning.text && (
            <p lang={reasoning.lang === locale ? undefined : reasoning.lang}>{reasoning.text}</p>
          )}
          {open.map((q) => (
            <QuestionBox {...issueBox(q)} />
          ))}
        </section>
      );
    })
  }
  {
    (ungroupedPages.length > 0 || areas.length > 0) && (
      <section>
        <h2>{t.openUngrouped}</h2>
        <p>{t.openUngroupedSub}</p>
        {ungroupedPages.map((p) => (
          <>
            <h3>
              <WikiLink to={p} locale={locale}>
                {p.title}
              </WikiLink>
            </h3>
            {p.markers.map((m) => (
              <QuestionBox
                kind={m.kind}
                heading={calloutHeading(m.kind, locale, questions.get(m.issue))}
                links={[{ href: wikiUrl(p.slug, m.id, p.locale), text: t.onThePage }]}
                markdown={m.markdown}
                page={p.slug}
                lang={p.locale}
                locale={locale}
              />
            ))}
          </>
        ))}
        {areas.length > 0 && (
          <>
            <h3>{t.openUnmarked}</h3>
            <p>{t.openUnmarkedSub}</p>
            {areas.map((g) => (
              <>
                <h4>{g.area ? (t.areaNames[g.area] ?? g.area) : t.noArea}</h4>
                {g.list.map((q) => (
                  <QuestionBox {...issueBox(q)} />
                ))}
              </>
            ))}
          </>
        )}
      </section>
    )
  }
</Wiki>
