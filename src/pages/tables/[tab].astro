---
import SheetTable from '../../components/SheetTable.astro';
import Wiki from '../../layouts/Wiki.astro';
import { url } from '../../lib/site';
import { isArchive, type SheetTab, TABS, tabTitle } from '../../lib/sheet';

export function getStaticPaths() {
  return TABS.map((tab) => ({ params: { tab: tab.slug }, props: { tab } }));
}

interface Props {
  tab: SheetTab;
}

const { tab } = Astro.props;
const title = tabTitle(tab);
---

<Wiki title={title} description={`The ${title} tab of the reference sheet.`}>
  <h1>{title}</h1>
  <p class="sub">
    <a href={url('/tables/')}>Sheet tables</a>{isArchive(tab) && ' · Archive: superseded ideas'}
  </p>
  {tab.blocks.map((_, i) => <SheetTable tab={tab.slug} block={i} />)}
</Wiki>
