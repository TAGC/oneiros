---
import '../styles/wiki.css';
import { SIDEBAR_AREAS } from '../lib/areas';
import { categoryUrl, url, wikiUrl } from '../lib/site';
import { resolve } from '../lib/wiki';

interface Tab {
  label: string;
  href?: string;
  current?: boolean;
  right?: boolean;
}

interface Props {
  title: string;
  description?: string;
  tabs?: Tab[];
  /** Show "What links here" in the sidebar (article pages). */
  article?: boolean;
}

const { title, description, article = false } = Astro.props;
const tabs = Astro.props.tabs ?? [{ label: 'Special page', current: true }];
const vision = resolve('Oneiros');
const pageTitle = title === 'Oneiros Wiki' ? title : `${title} – Oneiros Wiki`;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;1,400&family=Source+Sans+3:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {
        /* Storage unavailable: follow the system theme. */
      }
    </script>
  </head>
  <body data-base={url('/')}>
    <a class="skip" href="#content">Skip to content</a>
    <header class="top">
      <button
        class="hbtn menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="side"
        aria-label="Menu"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M2 4h14M2 9h14M2 14h14" stroke="currentColor" stroke-width="2"></path>
        </svg>
      </button>
      <a class="logo" href={url('/')}>
        <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true">
          <circle cx="15" cy="15" r="12" fill="none" stroke="#fff" stroke-width="2"></circle>
          <path d="M15 3a12 12 0 0 1 0 24a7 12 0 0 0 0-24z" fill="#e8962e"></path>
        </svg>
        <span>Oneiros Wiki</span>
      </a>
      <form class="search" role="search" action={url('/glossary/')}>
        <input
          id="q"
          type="search"
          name="q"
          placeholder="Search the Dreamlands"
          aria-label="Search"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="results"
          aria-autocomplete="list"
        />
        <ul id="results" class="results" role="listbox" aria-label="Search results" hidden></ul>
      </form>
      <button class="hbtn theme-btn" type="button" aria-label="Theme: system">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <circle cx="9" cy="9" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M9 2a7 7 0 0 1 0 14z" fill="currentColor"></path>
        </svg>
        <span class="lbl">Auto</span>
      </button>
    </header>
    <div class="shell">
      <nav class="side" id="side" aria-label="Site">
        <div>
          <ul>
            <li><a href={url('/')}>Main page</a></li>
            <li><a href={url('/random/')}>Random page</a></li>
            <li><a href={url('/glossary/')}>Glossary index</a></li>
            <li>
              {
                vision.exists ? (
                  <a href={wikiUrl(vision.slug)} data-t={vision.slug}>
                    Vision
                  </a>
                ) : (
                  <a class="new" href={wikiUrl(vision.slug)} title="Oneiros (page does not exist)">
                    Vision
                  </a>
                )
              }
            </li>
            <li><a href={url('/tables/')}>Sheet tables</a></li>
          </ul>
        </div>
        <div>
          <h2>Areas</h2>
          <ul>
            {
              SIDEBAR_AREAS.map((area) => (
                <li>
                  <a href={categoryUrl(area)}>{area}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2>Tools</h2>
          <ul>
            {
              article && (
                <li>
                  <a href="#links">What links here</a>
                </li>
              )
            }
            <li><a href={url('/open-questions/')}>Open questions</a></li>
          </ul>
        </div>
      </nav>
      <main id="content">
        <div class="tabs">
          {
            tabs.map((t) =>
              t.href && !t.current ? (
                <a class={t.right ? 'right' : undefined} href={t.href}>
                  {t.label}
                </a>
              ) : (
                <span class={t.right ? 'right' : undefined} aria-current="page">
                  {t.label}
                </span>
              ),
            )
          }
        </div>
        <article>
          <slot />
        </article>
        <footer class="foot">
          <slot name="footer" />
          <p>
            Oneiros is a just-for-fun game design project. Text drawn from the vision doc and
            Glossary.
          </p>
        </footer>
      </main>
    </div>
    <div id="pop" role="tooltip"></div>
    <script>
      import '../scripts/wiki';
    </script>
  </body>
</html>
