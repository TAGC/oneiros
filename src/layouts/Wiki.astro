---
import '../styles/wiki.css';
import IconFrame from '../components/IconFrame.astro';
import WikiLink from '../components/WikiLink.astro';
import { DEFAULT_LOCALE, HTML_LANG, type Locale, LOCALES, CJK_FONTS, otherLocale } from '../i18n/locale';
import { useTranslations } from '../i18n/ui';
import { SIDEBAR_AREAS } from '../lib/areas';
import { categoryUrl, SITE, url } from '../lib/site';
import { categoryLabel, resolve } from '../lib/wiki';

interface Tab {
  label: string;
  href?: string;
  current?: boolean;
  right?: boolean;
}

interface Props {
  title: string;
  description?: string;
  tabs?: Tab[];
  /** Show "What links here" in the sidebar (article pages). */
  article?: boolean;
  locale?: Locale;
  /** The page's path below the language root, such as `/glossary/`: drives the language switch. */
  path?: string;
  /** Whether the page exists in the other language too. */
  translated?: boolean;
}

const { title, description, article = false, locale = DEFAULT_LOCALE, path } = Astro.props;
const translated = Astro.props.translated ?? true;
const t = useTranslations(locale);
const other = otherLocale(locale);
const o = useTranslations(other);
const tabs = Astro.props.tabs ?? [{ label: t.specialPage, current: true }];
const vision = resolve('Oneiros', locale);
const pageTitle = title === t.siteName ? title : `${title} – ${t.siteName}`;
const alternates = path
  ? LOCALES.filter((l) => l === locale || translated).map((l) => ({
      lang: HTML_LANG[l],
      href: SITE + url(path, l),
    }))
  : [];
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {
      alternates.length > 1 && (
        <link rel="alternate" hreflang="x-default" href={SITE + url(path, DEFAULT_LOCALE)} />
      )
    }
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,400;0,600;1,400;1,600&family=Source+Sans+3:wght@400;600&display=swap"
      rel="stylesheet"
    />
    {locale === 'zh' && <link href={CJK_FONTS} rel="stylesheet" />}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {
        /* Storage unavailable: follow the system theme. */
      }
    </script>
  </head>
  <body data-base={url('/')} data-root={url('/', locale)}>
    <a class="skip" href="#content">{t.skip}</a>
    <header class="top">
      <button
        class="hbtn menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="side"
        aria-label={t.menu}
      >
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M2 4h14M2 9h14M2 14h14" stroke="currentColor" stroke-width="2"></path>
        </svg>
      </button>
      <a class="logo" href={url('/', locale)}>
        <svg width="30" height="30" viewBox="0 0 30 30" aria-hidden="true">
          <circle cx="15" cy="15" r="12" fill="none" stroke="#fff" stroke-width="2"></circle>
          <path d="M15 3a12 12 0 0 1 0 24a7 12 0 0 0 0-24z" fill="#e8962e"></path>
        </svg>
        <span>{t.siteName}</span>
      </a>
      <form
        class="search"
        role="search"
        action={url('/glossary/', locale)}
        data-unavailable={t.searchUnavailable}
        data-none={t.searchNone}
      >
        <input
          id="q"
          type="search"
          name="q"
          placeholder={t.searchPlaceholder}
          data-short-placeholder={t.search}
          aria-label={t.search}
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="results"
          aria-autocomplete="list"
        />
        <ul id="results" class="results" role="listbox" aria-label={t.searchResults} hidden></ul>
      </form>
      {
        path &&
          (translated ? (
            <a
              class="hbtn lang-btn"
              href={url(path, other)}
              hreflang={HTML_LANG[other]}
              lang={HTML_LANG[other]}
              title={o.readIn}
            >
              {o.languageName}
            </a>
          ) : (
            <span
              class="hbtn lang-btn"
              role="link"
              aria-disabled="true"
              tabindex="0"
              lang={HTML_LANG[other]}
              title={t.noTranslation}
            >
              {o.languageName}
            </span>
          ))
      }
      <button
        class="hbtn theme-btn"
        type="button"
        aria-label={t.theme + t.colon + t.themeSystem}
        data-theme-label={t.theme + t.colon}
        data-system={t.themeSystem}
        data-light={t.themeLight}
        data-dark={t.themeDark}
        data-auto-label={t.themeAuto}
        data-light-label={t.themeLightLabel}
        data-dark-label={t.themeDarkLabel}
      >
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <circle cx="9" cy="9" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M9 2a7 7 0 0 1 0 14z" fill="currentColor"></path>
        </svg>
        <span class="lbl">{t.themeAuto}</span>
      </button>
    </header>
    <div class="shell">
      <nav class="side" id="side" aria-label="Site">
        <div>
          <ul>
            <li><a href={url('/', locale)}>{t.mainPage}</a></li>
            <li><a href={url('/random/', locale)}>{t.randomPage}</a></li>
            <li><a href={url('/glossary/', locale)}>{t.glossaryIndex}</a></li>
            <li><WikiLink to={vision} locale={locale}>{t.vision}</WikiLink></li>
            <li><a href={url('/tables/', locale)}>{t.sheetTables}</a></li>
          </ul>
        </div>
        <div>
          <h2>{t.areas}</h2>
          <ul>
            {
              SIDEBAR_AREAS.map((area) => (
                <li>
                  <a class="area-link" href={categoryUrl(area, locale)}>
                    <IconFrame name={area} size="sm" />
                    {categoryLabel(area, locale)}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2>{t.tools}</h2>
          <ul>
            {
              article && (
                <li>
                  <a href="#links">{t.whatLinksHere}</a>
                </li>
              )
            }
            <li><a href={url('/open-questions/', locale)}>{t.openQuestions}</a></li>
            <li><a href={url('/astrolabe/', locale)}>{t.astrolabe.name}</a></li>
            <li><a href={url('/status/', locale)}>{t.status}</a></li>
          </ul>
        </div>
      </nav>
      <main id="content">
        <div class="tabs">
          {
            tabs.map((t) =>
              t.href && !t.current ? (
                <a class={t.right ? 'right' : undefined} href={t.href}>
                  {t.label}
                </a>
              ) : (
                <span class={t.right ? 'right' : undefined} aria-current="page">
                  {t.label}
                </span>
              ),
            )
          }
        </div>
        <article>
          <slot />
        </article>
        <footer class="foot">
          <slot name="footer" />
          <p>{t.footer}</p>
        </footer>
      </main>
    </div>
    <div id="pop" role="tooltip"></div>
    <script>
      import '../scripts/wiki';
    </script>
  </body>
</html>
