---
/** The key: what each glyph, line and glow means. */
import { type Locale } from '../i18n/locale';
import { useTranslations } from '../i18n/ui';
import { CENTRAL_MIN_DEPENDENTS, THREAD_KINDS } from '../lib/questions';
import type { Role } from '../lib/questions';
import { STAR_STATUSES } from './chart';
import Glyph from './Glyph.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const a = useTranslations(locale).astrolabe;
const roles: Role[] = ['central', 'peripheral', 'independent'];
---

<details class="al-key" open>
  <summary>{a.key}</summary>
  <div class="al-key-grid">
    <ul>
      {
        STAR_STATUSES.map((status) => (
          <li>
            <svg class="al-key-mark" viewBox="-16 -16 32 32" aria-hidden="true">
              <Glyph status={status} />
            </svg>
            <span>
              <b>{a.named(a.status[status])}</b> {a.statusHelp[status]}
            </span>
          </li>
        ))
      }
      <li>
        <svg class="al-key-mark" viewBox="-16 -16 32 32" aria-hidden="true">
          <Glyph status="frontier" conflict />
        </svg>
        <span><b>{a.named(a.conflict)}</b> {a.conflictHelp}</span>
      </li>
    </ul>
    <ul>
      {
        roles.map((role) => (
          <li>
            <svg class="al-key-mark" viewBox="-16 -16 32 32" aria-hidden="true">
              <Glyph status="frontier" roles={[role]} />
            </svg>
            <span>
              <b>{a.named(a.roles[role])}</b> {a.roleHelp[role](CENTRAL_MIN_DEPENDENTS)}
            </span>
          </li>
        ))
      }
      {
        THREAD_KINDS.map((kind) => (
          <li>
            <svg class="al-key-mark" viewBox="0 -8 40 16" aria-hidden="true">
              <path
                class={`al-thread al-thread-${kind}`}
                d="M2,0H32"
                marker-end={`url(#al-arrow-${kind})`}
              />
            </svg>
            <span>{a.threads[kind]}</span>
          </li>
        ))
      }
      <li>
        <span class="al-key-glow" aria-hidden="true"></span>
        <span>{a.areaGlow}</span>
      </li>
      <li>
        <svg class="al-key-mark" viewBox="0 -8 40 16" aria-hidden="true">
          <line class="al-cline" x1="5" y1="4" x2="35" y2="-4" />
          <circle class="al-cring" cx="5" cy="4" r="3" />
          <circle class="al-cring" cx="35" cy="-4" r="3" />
        </svg>
        <span>{a.constellationKey}</span>
      </li>
      <li>
        <svg class="al-key-mark" viewBox="-16 -16 32 32" aria-hidden="true">
          <Glyph status="blocked" warn />
        </svg>
        <span>{a.ungroupedKey}</span>
      </li>
    </ul>
  </div>
</details>
